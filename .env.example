# Copy to .env.local and fill in real values. Never commit .env.local.
# The deployed site reads the same variables from the Railway service settings.

# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secret-key"

# Admin sign-in
# ADMIN_PASSWORD is required: it is the password for the super admin
# (whitney.walters@gmail.com) and for the shared admin account below. If it is
# unset, both of those logins are disabled — only admin users stored in the
# database can sign in. There is no fallback value in the source.
ADMIN_PASSWORD=""
# Optional; defaults to admin@walters-pierce-wedding.com
ADMIN_EMAIL="admin@walters-pierce-wedding.com"

# Email (Resend)
RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@walters-pierce-wedding.com"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
